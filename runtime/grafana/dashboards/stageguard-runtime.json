{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "stageguard-prometheus"},
      "description": "1 while a remediation dispatch/recovery verification is in flight.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "idle"}, "1": {"text": "active"}}, "type": "value"}], "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "stageguard_remediation_execution_active", "legendFormat": "active", "range": true, "refId": "A"}],
      "title": "Remediation execution",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stageguard-prometheus"},
      "description": "Fail-closed watchdog signal. A value of 1 withdraws StageGuard readiness.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "within deadline"}, "1": {"text": "DEADLINE EXCEEDED"}}, "type": "value"}], "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "stageguard_remediation_execution_deadline_exceeded", "legendFormat": "deadline", "range": true, "refId": "A"}],
      "title": "Execution watchdog",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stageguard-prometheus"},
      "description": "Monotonic elapsed time for the active remediation compared with its configured safety bound.",
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 3,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "stageguard_remediation_execution_age_seconds", "legendFormat": "execution age", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "stageguard_remediation_execution_max_seconds", "legendFormat": "configured maximum", "range": true, "refId": "B"}
      ],
      "title": "Remediation age vs safety deadline",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stageguard-prometheus"},
      "description": "Seconds remaining before StageGuard withdraws readiness. Negative values indicate the bound has been exceeded.",
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 6},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "stageguard_remediation_execution_max_seconds - stageguard_remediation_execution_age_seconds", "legendFormat": "deadline headroom", "range": true, "refId": "A"}],
      "title": "Watchdog headroom",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stageguard-prometheus"},
      "description": "Age of the newest watchdog deadline sample. More than 45 seconds means StageGuard can no longer trust an apparently healthy zero value.",
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 30}, {"color": "red", "value": 45}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "max(time() - timestamp(stageguard_remediation_execution_deadline_exceeded)) or vector(1000000000) * absent(stageguard_remediation_execution_deadline_exceeded)", "legendFormat": "sample age", "range": true, "refId": "A"}],
      "title": "Watchdog telemetry freshness",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stageguard-prometheus"},
      "description": "Prometheus transport health for the runtime watchdog scrape. A zero identifies scrape/bridge/IAM/network failure before metric freshness ages out; it does not itself prove a remediation deadline breach.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "SCRAPE FAILING"}, "1": {"text": "scrape healthy"}}, "type": "value"}], "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 14},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "min(up{job=\"stageguard-runtime-watchdog\"})", "legendFormat": "scrape health", "range": true, "refId": "A"}],
      "title": "Watchdog scrape health",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stageguard-prometheus"},
      "description": "Fresh Grafana telemetry has proven the accepted remediation recovered the live workflow. A zero means recovery is not yet proven or no recovery outcome exists.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "not verified"}, "1": {"text": "RECOVERED"}}, "type": "value"}], "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 20},
      "id": 7,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "stageguard_recovery_verified", "legendFormat": "verified", "range": true, "refId": "A"}],
      "title": "Recovery verification",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stageguard-prometheus"},
      "description": "1 means the remediation provider has already accepted the action and only the no-replay Grafana recovery-recheck path is allowed.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "not eligible"}, "1": {"text": "RECHECK ONLY"}}, "type": "value"}], "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 20},
      "id": 8,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "stageguard_recovery_recheck_eligible", "legendFormat": "no-replay recheck", "range": true, "refId": "A"}],
      "title": "Recovery recheck eligibility",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stageguard-prometheus"},
      "description": "Integrity guard for durable recovery state. Zero means the recovery outcome and execution checkpoint phase disagree; StageGuard readiness fails closed.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "INCONSISTENT"}, "1": {"text": "consistent"}}, "type": "value"}], "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 20},
      "id": 9,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "stageguard_recovery_checkpoint_phase_consistent", "legendFormat": "checkpoint phase", "range": true, "refId": "A"}],
      "title": "Recovery checkpoint consistency",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stageguard-prometheus"},
      "description": "Bounded number of recovery evidence samples retained in the durable outcome. This metric carries no incident, provider, query, target, or revision labels.",
      "fieldConfig": {"defaults": {"min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 20},
      "id": 10,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "stageguard_recovery_sample_count", "legendFormat": "samples", "range": true, "refId": "A"}],
      "title": "Recovery evidence samples",
      "type": "stat"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
